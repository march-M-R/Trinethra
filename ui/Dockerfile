FROM node:22-alpine

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .

ARG NEXT_PUBLIC_AUTOMATION_API_BASE=http://localhost:8003
ARG NEXT_PUBLIC_EXPLAIN_API_BASE=http://localhost:8001
ENV NEXT_PUBLIC_AUTOMATION_API_BASE=$NEXT_PUBLIC_AUTOMATION_API_BASE
ENV NEXT_PUBLIC_EXPLAIN_API_BASE=$NEXT_PUBLIC_EXPLAIN_API_BASE

RUN npm run build
EXPOSE 3000
CMD ["npm", "start"]
